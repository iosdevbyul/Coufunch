          }
        }
      }
    },
    "Estimated using the 2026 employee social insurance rate (9.717383%). Actual deductions, tax, and eligibility may differ.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2026년 근로자 사회보험료율(9.717383%)로 추정한 금액입니다. 실제 공제액, 세금 및 가입 조건에 따라 달라질 수 있습니다."
          }
        }
      }
    },
    "Average per completed day": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 근무일당 평균 급여"
