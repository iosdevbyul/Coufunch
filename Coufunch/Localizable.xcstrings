        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜에는 이미 완료한 근무 기록이 있습니다. 추가 근무를 등록해도 근무일수는 늘어나지 않습니다."
          }
        }
      }
    },
    "New bonus unlocked": {
      "localizations": {
        "ko": {
          "stringUnit": {
